# AgriN environment variables — placeholder names only.
# Copy to .env for local development. NEVER put real secrets in this file.

# Runtime
ENV=dev                      # dev | prod
LOG_LEVEL=INFO

# Database (dev credentials for the docker-compose Postgres — not secrets)
# Host port is 65432 because native PostgreSQL services already occupy 5432/5433
# on this dev host, and Windows reserves 55345-55444 (dynamic exclusion range).
# `ssl=disable` because the local container has no TLS.
DATABASE_URL=postgresql+asyncpg://agrin:agrin@localhost:65432/agrin?ssl=disable

# Auth — generate a real secret for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# CORS — explicit allow-list, comma separated (no wildcard once auth exists)
CORS_ORIGINS=http://localhost:5173

# External provider modes: demo | live  (filled in by provider milestones)
WEATHER_PROVIDER=demo
SATELLITE_PROVIDER=demo
SOIL_PROVIDER=demo
DISEASE_PROVIDER=demo
LLM_PROVIDER=demo

# Demo seed (M054) — login password for the fixed @agrin.demo users.
# Unset = documented dev default (Demo-Passw0rd!); REQUIRED when ENV=prod.
DEMO_PASSWORD=

# Security hardening (M055)
# Sliding-window rate limit on /auth/login and /auth/refresh, per client IP,
# in-process (per worker — see src/core/ratelimit.py for the multi-worker note).
AUTH_RATE_LIMIT_PER_MINUTE=10
# Interactive API docs. Keep true for dev; set false in production.
DOCS_ENABLED=true

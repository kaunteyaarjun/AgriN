# AgriN environment variables — placeholder names only.
# Copy to .env for local development. NEVER put real secrets in this file.

# Runtime
ENV=dev                      # dev | prod
LOG_LEVEL=INFO

# Database (dev credentials for the docker-compose Postgres — not secrets)
DATABASE_URL=postgresql+asyncpg://agrin:agrin@localhost:5432/agrin

# Auth — generate a real secret for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# CORS — explicit allow-list, comma separated (no wildcard once auth exists)
CORS_ORIGINS=http://localhost:5173

# External provider modes: demo | live  (filled in by provider milestones)
WEATHER_PROVIDER=demo
SATELLITE_PROVIDER=demo
SOIL_PROVIDER=demo
DISEASE_PROVIDER=demo
LLM_PROVIDER=demo
